# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it holds production secrets.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000

# development | production
# In production this also makes JWT_SECRET validation strict (see below)
# and switches request logging to the fuller 'combined' format.
NODE_ENV=development

# Exact origin the frontend is served from — no trailing slash, no
# wildcards. Browsers enforce this, so it must match exactly.
#   Dev:  http://localhost:5173
#   Prod: https://app.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL, via Prisma)
# ---------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# The values below are placeholders for local development only.
# In production, use a dedicated database user with access to only this
# database (never a superuser), and append connection-pool tuning if your
# host recommends it, e.g. "...?schema=public&connection_limit=10".
DATABASE_URL="postgresql://agri_user:agri_password@localhost:5432/agri_business_db"

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters and never reused across environments.
# In production the app refuses to start if this is missing, too short,
# or still set to a known placeholder value (see src/config/env.ts).
JWT_SECRET="replace-with-a-long-random-string"

JWT_EXPIRES_IN="1d"
