# Copy this file to .env (development) — or set the same variable in
# your hosting platform's build-time environment for production.
#
# IMPORTANT: Vite inlines VITE_* variables into the JS bundle at BUILD
# time, not at server start time. Changing this value later requires
# rebuilding the frontend (`npm run build`) — editing .env on a server
# that's just serving the already-built dist/ folder has no effect.

# Base URL of the backend API, including the /api prefix.
#   Dev:  http://localhost:5000/api
#   Prod: https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:5000/api
